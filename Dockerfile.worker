# The eval worker. Separate from the server's Dockerfile because it needs the
# docker CLI (it starts sandbox containers) and a shell-bearing base to carry
# it; the server stays on distroless/static with no socket and no LLM key.

# CGO_ENABLED=0 is safe: the eval store's SQLite driver is modernc.org/sqlite.
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# The server refuses a report whose engine_version is "" or "dev" — a constant
# there defeats report.Comparable's same-build check, so two worker builds
# would chart as one trend. "dev" is what main.version holds when nothing sets
# it, so a build without these flags runs a whole tier, scores it, and is then
# rejected at the last step with nothing to show for the spend.
#
# The default is a constant, so it does not make Comparable meaningful — it
# only clears the guard. Pass a real value for a deployment you intend to keep
# score history for: --build-arg VERSION=1.4.0, or SKAEL_VERSION in compose.
# The fallback is applied in the shell, not as the ARG default: an explicitly
# empty --build-arg (which is what compose passes for an unset variable)
# overrides an ARG default with "", and "" is rejected exactly like "dev".
ARG VERSION=
RUN v="${VERSION:-0.0.0-local}" && \
    CGO_ENABLED=0 go build -ldflags "-X main.version=${v}" -o /skael-worker ./cmd/skael-worker

# docker-cli is the client only — it talks to whatever daemon the mounted
# socket belongs to. ca-certificates reaches the Skael API and the LLM gateway.
FROM alpine:3.21
RUN apk add --no-cache docker-cli ca-certificates

# The Northflank driver shells out to this CLI to copy a session's workspace.
# Pinned: an updated CLI can change the argv the driver builds. The Node floor
# is what @northflank/cli 0.12.2 declares it needs. coreutils replaces
# busybox's env, which lacks the -S flag the CLI's own shebang requires.
RUN apk add --no-cache nodejs npm coreutils \
    && node -e 'const [a,b]=process.versions.node.split(".").map(Number); if (a<22 || (a===22 && b<13)) { console.error("node "+process.versions.node+" is below the 22.13.0 @northflank/cli requires"); process.exit(1) }' \
    && npm i -g @northflank/cli@0.12.2

COPY --from=build /skael-worker /usr/local/bin/skael-worker

# Both roots must resolve to the same path inside the container and on the
# host, since the daemon resolves bind sources on the host. Bind each as
# `-v /var/lib/skael/run:/var/lib/skael/run`; a named volume does not work. See
# docker-compose.yml.
ENV WORKER_RUN_ROOT=/var/lib/skael/run
ENV WORKER_WORK_ROOT=/var/lib/skael/work
RUN mkdir -p /var/lib/skael/run /var/lib/skael/work

ENTRYPOINT ["/usr/local/bin/skael-worker"]
