bin/

# Binaries built at the repo root by `go build ./cmd/...`
/skael
/skael-server
/skael-worker
/whetstone
/migrate
/server
.env
data/
*.tar.gz
# Private build repository, and its docs symlink. No trailing slash: a worktree
# holds these as symlinks, and "/docs/" does not match a symlink. Root only; do
# NOT match site/src/content/docs/
/.build
/docs
# Agent scratch workspaces: task briefs, reports and ledgers that quote the
# private docs above. Never publishable.
/.superpowers/
web/dist/*
!web/dist/.gitkeep
web/src/api/
web/openapi.json
web/node_modules/
web/*.tsbuildinfo

# GoReleaser output. Only CI publishes, but `goreleaser release --snapshot`
# is the one way to check a formula without cutting a release, and it drops
# every binary for every platform in here.
dist/
docker-compose.override*.yml
