bin/

# Binaries built at the repo root by `go build ./cmd/...`
/skael
/skael-server
/skael-worker
/whetstone
/migrate
/server
.env
data/
*.tar.gz
# Private product docs (specs, plans, PRD) — root only; do NOT match site/src/content/docs/
/docs/
# Agent scratch workspaces: task briefs, reports and ledgers that quote the
# private docs above. Never publishable.
/.superpowers/
web/dist/*
!web/dist/.gitkeep
web/src/api/
web/openapi.json
web/node_modules/
web/*.tsbuildinfo

# GoReleaser output. Only CI publishes, but `goreleaser release --snapshot`
# is the one way to check a formula without cutting a release, and it drops
# every binary for every platform in here.
dist/
docker-compose.override*.yml
