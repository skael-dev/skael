<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{.Skill}} — eval report</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --fg: #1a1a1a;
    --muted: #5a5a5a;
    --border: #d8d8d8;
    --panel: #f6f6f7;
    --accent: #f59e0b;
    --bad: #b3261e;
    --good: #1e6e3c;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #16171a;
      --fg: #e8e8e8;
      --muted: #a0a0a0;
      --border: #3a3b3f;
      --panel: #1f2023;
      --accent: #f59e0b;
      --bad: #ff8a80;
      --good: #7fd99a;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 2rem 1rem;
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    line-height: 1.5;
  }
  .wrap { max-width: 960px; margin: 0 auto; }
  h1, h2, h3 { font-weight: 600; }
  h1 { font-size: 1.5rem; margin-bottom: 0.25rem; }
  h2 { font-size: 1.15rem; margin-top: 2.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.3rem; }
  h3 { font-size: 1rem; margin-bottom: 0.25rem; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em; }
  .meta { color: var(--muted); font-size: 0.9rem; }
  .banner {
    border: 1px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, var(--bg));
    border-radius: 6px;
    padding: 0.75rem 1rem;
    margin: 1rem 0;
  }
  .banner.bad {
    border-color: var(--bad);
    background: color-mix(in srgb, var(--bad) 12%, var(--bg));
  }
  .table-scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
  th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--border); white-space: nowrap; }
  th { color: var(--muted); font-weight: 600; }
  tr.unhealthy td { color: var(--bad); }
  .card {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.9rem 1rem;
    margin-bottom: 1rem;
    background: var(--panel);
  }
  .headline-value { font-size: 2rem; font-weight: 700; }
  .headline-ci { color: var(--muted); }
  .pill {
    display: inline-block;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.05rem 0.6rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .quote {
    border-left: 3px solid var(--accent);
    padding: 0.3rem 0.7rem;
    margin: 0.3rem 0;
    color: var(--muted);
    font-size: 0.9rem;
    white-space: pre-wrap;
  }
  ul { padding-left: 1.2rem; }
  .empty { color: var(--muted); font-style: italic; }
  footer { margin-top: 3rem; color: var(--muted); font-size: 0.8rem; }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <h1>{{.Skill}}</h1>
    <p class="meta">
      spec v{{.SpecVersion}} &middot; tier <strong>{{.Tier}}</strong>
      &middot; eval set {{shortref .SuiteRef}}
      &middot; engine {{.EngineVersion}}
      {{if .GraderModel}}&middot; graded by {{.GraderModel}}{{end}}
      &middot; started {{if .StartedAt.IsZero}}<span class="empty">not recorded</span>{{else}}{{.StartedAt.Format "2006-01-02 15:04 MST"}}{{end}}
      {{if not .FinishedAt.IsZero}}&middot; finished {{.FinishedAt.Format "2006-01-02 15:04 MST"}}{{end}}
    </p>
  </header>

  {{if not .PanelComplete}}
  <div class="banner bad">
    <strong>Panel incomplete.</strong> Not every planned panel member contributed to this run. The
    headline is the lowest score across the members that did, so treat it as a lower bound rather
    than the full picture.
  </div>
  {{end}}

  {{if .BaselineWipeout}}
  <div class="banner">
    <strong>Baseline passed nothing.</strong> No baseline run passed a single expectation. That is
    the shape a genuinely hard eval set takes, and it is also the shape a broken baseline harness
    takes. Rule the second out before concluding the first.
  </div>
  {{end}}

  <h2>Headline</h2>
  <div class="card">
    <div class="headline-value">{{round1 .Headline}} / 100</div>
    <p class="meta">
      The share of expectations this skill passed, averaged over evals, on the weakest healthy
      panel member.
    </p>
    <p>
      {{if .DeltaMeasured}}
        <span class="pill">without the skill: {{round1 .Baseline}}</span>
        <span class="pill">delta: {{round1 .Delta}}</span>
      {{else}}
        <span class="pill">no baseline ran &mdash; delta not measured</span>
      {{end}}
      <span class="pill">trigger F1: {{pct .TriggerF1}}</span>
      {{if .TriggerInferred}}<span class="pill">firing inferred from a read, not an invocation</span>{{end}}
      {{if .TriggerUnknown}}<span class="pill">{{.TriggerUnknown}} probe(s) unmeasurable</span>{{end}}
    </p>
  </div>

  <h2>Panel</h2>
  <div class="table-scroll">
  <table>
    <thead>
      <tr><th>Member</th><th>Class</th><th>Score (0&ndash;100)</th><th>Health</th></tr>
    </thead>
    <tbody>
      {{range .Members}}
      <tr{{if not .Healthy}} class="unhealthy"{{end}}>
        <td>{{.Member.Agent}} / {{.Member.Model}}{{if .MetaPartial}} <span class="pill" title="{{.MetaPartialReason}}">partial meta</span>{{end}}</td>
        <td>{{.Member.Class}}</td>
        {{if .Healthy}}
        <td>{{round1 .Effectiveness}}</td>
        <td>ok</td>
        {{else}}
        <td colspan="2">not measured &mdash; {{if .Detail}}{{.Detail}}{{else}}no reason recorded{{end}}</td>
        {{end}}
      </tr>
      {{end}}
    </tbody>
  </table>
  </div>

  {{if .VoidTasks}}
  <h2>Excluded evals</h2>
  <ul>
    {{range .VoidTasks}}
    <li><code>{{.TaskID}}</code> &mdash; {{.Reason}}</li>
    {{end}}
  </ul>
  {{end}}

  <h2>Evals</h2>
  {{range .Tasks}}
  <div class="card">
    <h3>eval {{.TaskID}}</h3>
    {{if .Conditions}}
    <div class="table-scroll">
    <table>
      <thead>
        <tr><th>Condition</th><th>Model</th><th>Expectations passed</th><th>Graded</th></tr>
      </thead>
      <tbody>
        {{range .Conditions}}
        <tr><td>{{.Condition}}</td><td>{{.Model}}</td><td>{{.Passes}}</td><td>{{.Runs}}</td></tr>
        {{end}}
      </tbody>
    </table>
    </div>
    {{end}}

    {{range .Grades}}
      {{if .Expectations}}
      <p class="meta">{{.Model}} &middot; {{.Condition}} &middot; attempt {{.Attempt}}</p>
      <ul>
        {{range .Expectations}}
        <li>{{if .Passed}}&check;{{else}}&cross;{{end}} {{.Text}}
          {{if .Evidence}}<div class="quote">{{.Evidence}}</div>{{end}}
        </li>
        {{end}}
      </ul>
      {{end}}
    {{end}}
  </div>
  {{else}}
  <p class="empty">No eval produced a scored run.</p>
  {{end}}

  <footer>Generated by whetstone.</footer>
</div>
</body>
</html>
