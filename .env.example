# Required
DATABASE_URL=postgres://skael:skael@localhost:5432/skael?sslmode=disable

# Optional — server
STORAGE_PATH=./data/skills   # or s3://bucket/prefix for S3-compatible object storage
LISTEN_ADDR=:8080
LOG_FORMAT=pretty
LOG_LEVEL=info               # trace, debug, info, warn, error, fatal, panic
# COOKIE_SECURE=true         # enable in production behind TLS
# DISABLE_SIGNUP=true        # lock down after initial setup
# CORS_ORIGINS=https://app.example.com,http://localhost:5173

# Proxies whose X-Forwarded-For / X-Real-IP may be believed (CIDRs or bare
# addresses, IPv4 or IPv6). Unset means neither header is trusted and the
# socket address is used — correct when skael is exposed directly. Behind a
# reverse proxy, set this to the proxy's address or every client is rate
# limited as one.
# TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1

# Rate limiting (per route class; auth is IP-only, everything else is charged
# to a hashed API key where present with a per-IP ceiling)
# RATE_LIMIT_AUTH=20         # requests/min for /api/auth/* (login, signup, password reset)
# RATE_LIMIT_EVENTS=600      # requests/min for POST /api/events (activation tracking)
# RATE_LIMIT_READ=300        # requests/min for GET/HEAD (list, search, manifest, downloads)
# RATE_LIMIT_WRITE=60        # requests/min for everything else (publish, import, delete)

# Database connection pool
# DB_MAX_CONNS=25
# DB_MIN_CONNS=5
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE_TIME=30m
# DB_HEALTH_CHECK_PERIOD=1m

# Analytics
# EVENT_RETENTION_DAYS=90    # 0 disables cleanup

# Observability
# METRICS_ENABLED=true       # set to false to disable /metrics endpoint

# S3 storage (only when STORAGE_PATH=s3://...). Omit keys to use an IAM instance role.
# S3_ENDPOINT=s3.amazonaws.com   # set for MinIO/R2/Spaces
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_USE_PATH_STYLE=true         # for MinIO
# S3_USE_SSL=true

# GitHub token for skill import (raises API rate limits)
# GITHUB_TOKEN=ghp_...

# skael-worker (the eval queue worker binary) — all three are required, and
# there is no fallback to a subscription CLI: a verified score has to come
# from a reproducible, metered backend.
# SKAEL_ENDPOINT=http://localhost:8080
# SKAEL_API_KEY=                 # a personal API key with permission to claim eval jobs
# ANTHROPIC_API_KEY=             # direct API gateway; not the subscription CLI on PATH
# WORKER_ID=                     # default: hostname-pid
# WORKER_LEASE=5m
# WORKER_POLL=15s
# WORKER_WORK_ROOT=              # default: the OS temp dir
# WORKER_CONCURRENCY=1

# Optional external security scanner (free/OSS, opt-in). Runs on publish/import
# in addition to the built-in scanner; "{dir}" is the skill directory and the
# command must print SARIF to stdout. The tool must be installed on the server.
# EXTERNAL_SCAN_CMD=gitleaks dir {dir} --report-format sarif --report-path /dev/stdout --exit-code 0
# EXTERNAL_SCAN_CMD=skill-scanner scan {dir} --format sarif   # Cisco AI skill-scanner (pip install cisco-ai-skill-scanner)
# EXTERNAL_SCAN_TIMEOUT=60s
