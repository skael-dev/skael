# Generated from internal/settings by `go run ./cmd/server --env-example`. Do not edit.
# Most server settings can also be changed on the Settings page. A variable set
# here wins over the page and locks its field.

# --- General (server) ---
# The URL people use to reach skael. Sign-in callbacks, email links and GitHub
# webhooks are built from it.
# PUBLIC_URL=

# --- Sign-up (server) ---
# Refuses new password, Google and GitHub accounts. OIDC stays open, because
# the identity provider is the gate.
# DISABLE_SIGNUP=false
# Comma-separated. A new account from any other domain is refused on every
# sign-in path.
# SIGNUP_ALLOWED_DOMAINS=

# --- Sign-in providers (server) ---
# The issuer URL of any OpenID Connect provider. The first sign-in creates a
# member, even with sign-up disabled.
# OIDC_ISSUER=
# From the application you register at the provider.
# OIDC_CLIENT_ID=
# From the application you register at the provider.
# OIDC_CLIENT_SECRET=
# An OAuth client of type Web application in Google Cloud.
# GOOGLE_CLIENT_ID=
# From the same Google OAuth client.
# GOOGLE_CLIENT_SECRET=
# A GitHub OAuth App. The GitHub App for git sync and the import token are
# separate.
# GITHUB_CLIENT_ID=
# From the same GitHub OAuth App.
# GITHUB_CLIENT_SECRET=

# --- Email (server) ---
# Turns on password reset and email change. For example smtp.postmarkapp.com
# or email-smtp.us-east-1.amazonaws.com.
# SMTP_HOST=
# 587 uses STARTTLS, 465 uses TLS from the first byte.
# SMTP_PORT=587
# Leave empty for a relay without authentication.
# SMTP_USERNAME=
# The SMTP password or the provider's API token.
# SMTP_PASSWORD=
# For example Skael <skael@example.com>. The provider must allow this sender.
# SMTP_FROM=

# --- Import (server) ---
# A personal access token for import. It raises GitHub's rate limit from 60 to
# 5000 requests an hour. Read-only public access is enough.
# GITHUB_TOKEN=

# --- Security scanning (server) ---
# Runs on every publish and import in addition to the built-in scanner. {dir}
# is the skill directory, and the command must print SARIF. The tool must be
# installed on the server.
# EXTERNAL_SCAN_CMD=
# A Go duration, for example 60s or 2m.
# EXTERNAL_SCAN_TIMEOUT=60s

# --- Quality gate (server) ---
# The minimum headline a verified evaluation must reach to release a held
# version. 0 accepts any verified report with a complete panel and no critical
# contract violation.
# QUALITY_FLOOR=0

# --- Analytics (server) ---
# Activation events older than this are deleted daily. 0 keeps every event.
# EVENT_RETENTION_DAYS=90
# Stores the person whose key sent each activation. Off stores no person, only
# the model, the harness and a hash of the machine. Turn it off where a works
# council or monitoring rule requires it.
# ACTIVATION_RECORD_IDENTITY=true
# Owners and admins always see everything recorded, and every member sees
# their own activations. Aggregates hide any model or harness that fewer than
# 5 people used.
# ACTIVATION_MEMBER_VISIBILITY=aggregate

# --- Webhooks (server) ---
# Lets deliveries reach private addresses, loopback, shared address space and
# http URLs, for a consumer on your own network. Link-local addresses stay
# refused.
# WEBHOOK_ALLOW_PRIVATE=false

# --- Rate limits (server) ---
# For /api/auth/*, per IP address.
# RATE_LIMIT_AUTH=20
# For POST /api/events, per API key, else per IP address.
# RATE_LIMIT_EVENTS=600
# For GET and HEAD, per API key, else per IP address.
# RATE_LIMIT_READ=300
# For every other method, per API key, else per IP address.
# RATE_LIMIT_WRITE=60
# For POST /api/eval/suites, which accepts up to 10 MB a call.
# RATE_LIMIT_SUITES=20

# --- Deployment (server) ---
# The Postgres connection string.
DATABASE_URL=postgres://skael:skael@localhost:5432/skael?sslmode=disable
# The HTTP listen address.
# LISTEN_ADDR=:8080
# Seals the secrets stored from the UI. Comma-separated id:base64key pairs of
# 32 bytes; the first seals, every one opens. Unset, the server generates a
# key file in the data directory.
# SKAEL_MASTER_KEYS=
# Where the server keeps the generated master key. Mount it on a volume. Unset
# uses the storage directory when STORAGE_PATH is a directory, else ./data.
# SKAEL_DATA_DIR=
# Marks the session cookie Secure. Needs TLS in front: a browser refuses a
# Secure cookie over plain HTTP, which breaks sign-in.
# COOKIE_SECURE=false
# CIDR blocks or addresses whose X-Forwarded-For, X-Real-IP and
# X-Forwarded-Proto are believed. Empty trusts none. Behind a proxy, set it,
# or every client shares one rate-limit bucket.
# TRUSTED_PROXIES=
# Comma-separated origins allowed to call the API from a browser.
# CORS_ORIGINS=

# --- Storage (server) ---
# Where archives live: a local directory, or s3://bucket/prefix. Unset on a
# new install stores archives in Postgres. An existing install keeps the store
# it started with.
# STORAGE_PATH=
# Set for MinIO, R2 or Spaces. No AWS_* fallback.
# S3_ENDPOINT=s3.amazonaws.com
# Falls back to AWS_REGION.
# S3_REGION=us-east-1
# Falls back to AWS_ACCESS_KEY_ID. Set both keys or neither; omit both for an
# IAM role.
# S3_ACCESS_KEY_ID=
# Falls back to AWS_SECRET_ACCESS_KEY.
# S3_SECRET_ACCESS_KEY=
# true for MinIO.
# S3_USE_PATH_STYLE=false
# TLS to the S3 endpoint.
# S3_USE_SSL=true

# --- Database pool (server) ---
# The most connections in the pool.
# DB_MAX_CONNS=25
# Idle connections the pool keeps.
# DB_MIN_CONNS=5
# A connection closes after this long.
# DB_MAX_CONN_LIFETIME=1h
# An idle connection closes after this long.
# DB_MAX_CONN_IDLE_TIME=30m
# How often the pool checks its connections.
# DB_HEALTH_CHECK_PERIOD=1m

# --- Logging and metrics (server) ---
# The lowest level written.
# LOG_LEVEL=info
# pretty writes colored console lines for development. Unset writes JSON.
# LOG_FORMAT=
# The same as LOG_FORMAT=pretty.
# LOG_PRETTY=false
# false removes the /metrics endpoint.
# METRICS_ENABLED=true

# --- Worker (worker) ---
# The skael server the worker claims jobs from.
# SKAEL_ENDPOINT=
# A key with permission to claim eval jobs. Settings → Workers → Add a
# worker creates one.
# SKAEL_API_KEY=
# Names this worker in leases and on the Workers page.
# WORKER_ID=
# How long a claimed job is held before another worker may take it.
# WORKER_LEASE=5m
# How often an idle worker asks for a job and checks in.
# WORKER_POLL=15s
# Where eval workspaces are built. Never mounted into a sandbox.
# WORKER_WORK_ROOT=
# Where session workspaces are created. They are bind-mounted into sandboxes,
# so in a container the path must be the same on the host. Required when
# containerized.
# WORKER_RUN_ROOT=
# Sandbox sessions at once within one eval.
# WORKER_CONCURRENCY=1
# Judge calls at once. A judge call is bound by the account's rate limit, not
# by the host.
# WORKER_GRADE_CONCURRENCY=8
# Each candidate runs its own sessions, so this multiplies the sandbox load.
# WORKER_CONTEST_PARALLEL=2

# --- Worker LLM credentials (worker) ---
# The credential of the Anthropic API preset, sent as x-api-key.
# ANTHROPIC_API_KEY=
# A gateway credential sent as a bearer token, such as an OpenRouter key.
# ANTHROPIC_AUTH_TOKEN=
# Set on a worker, it pins that worker to its own gateway and the server's
# providers do not apply to it.
# ANTHROPIC_BASE_URL=
# Set on a worker, it pins that worker's panel, most capable first, and the
# server's panel does not apply to it.
# LLM_MODEL=
# From claude setup-token. The credential of the Claude subscription provider,
# for panel members only.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Sandbox driver (worker) ---
# Where an eval session runs.
# SANDBOX_DRIVER=docker

# --- Kubernetes driver (worker) ---
# The namespace session pods run in. It must hold nothing but session pods.
# SANDBOX_K8S_NAMESPACE=
# The image a session pod runs. It must already be in a registry.
# SANDBOX_K8S_IMAGE=
# An image pull secret in the namespace, for a private registry.
# SANDBOX_K8S_PULL_SECRET=
# runtimeClassName for a hardware-isolated runtime, for example kata.
# SANDBOX_K8S_RUNTIME_CLASS=
# Asserts the runtime is hardware-isolated. Accepted only as the exact
# lowercase string `true`; any other value reads as unasserted and the driver
# refuses a run that needs it.
# SANDBOX_K8S_HARDWARE_ISOLATED=
# Asserts the cluster's CNI enforces NetworkPolicy. Check it with whetstone
# doctor --check-egress. Accepted only as the exact lowercase string `true`;
# any other value reads as unasserted and the driver refuses a run that needs
# it.
# SANDBOX_K8S_NETWORK_POLICY=

# --- Northflank driver (worker) ---
# The Northflank API token.
# SANDBOX_NF_TOKEN=
# Give sessions a project of their own: the driver deletes every service with
# its owner label.
# SANDBOX_NF_PROJECT=
# The base image a session runs.
# SANDBOX_NF_IMAGE=
# A saved Northflank credential, for a private registry.
# SANDBOX_NF_REGISTRY_CREDENTIAL=
# The resource plan of each session service.
# SANDBOX_NF_PLAN=nf-compute-20
# The CLI the driver uses for workspace transfer.
# SANDBOX_NF_CLI=northflank
# The domains your project's egress policy permits.
# SANDBOX_NF_ALLOWED_DOMAINS=
# Asserts the project's egress policy enforces the allowed domains. Accepted
# only as the exact lowercase string `true`; any other value reads as
# unasserted and the driver refuses a run that needs it.
# SANDBOX_NF_NETWORK_POLICY=
# Asserts the plan is hardware-isolated. Accepted only as the exact lowercase
# string `true`; any other value reads as unasserted and the driver refuses a
# run that needs it.
# SANDBOX_NF_HARDWARE_ISOLATED=
